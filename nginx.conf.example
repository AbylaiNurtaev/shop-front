server {
    listen 80;
    server_name your-domain.com;
    root /path/to/your/dist;
    index index.html;

    # Сжатие
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json;

    # Кэширование статических файлов
    location ~* \.(jpg|jpeg|gif|png|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(css|js)$ {
        expires 1M;
        add_header Cache-Control "public";
    }

    # Обработка всех маршрутов - перенаправление на index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Исключаем API запросы (если API на том же домене)
    location /api/ {
        # Проксируем на ваш API сервер
        # proxy_pass http://your-api-server;
        # Или оставьте как есть, если API на другом домене
    }
}
